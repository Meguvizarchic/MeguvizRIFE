@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(MeguvizCompute 1.2.2 CONFIG)
if(NOT TARGET MeguvizCompute::backend_ncnn_sdk)
  set(MeguvizRIFE_FOUND FALSE)
  set(MeguvizRIFE_NOT_FOUND_MESSAGE "The exact Compute private ncnn SDK target is required")
  return()
endif()
get_target_property(_mgr_installed_compute_fingerprint MeguvizCompute::backend_ncnn_sdk INTERFACE_MGC_PRIVATE_SDK_FINGERPRINT)
if(NOT _mgr_installed_compute_fingerprint STREQUAL "@MGR_PRIVATE_FP@")
  set(MeguvizRIFE_FOUND FALSE)
  set(MeguvizRIFE_NOT_FOUND_MESSAGE "Compute private SDK fingerprint mismatch: RIFE requires @MGR_PRIVATE_FP@, got ${_mgr_installed_compute_fingerprint}")
  return()
endif()
unset(_mgr_installed_compute_fingerprint)
include("${CMAKE_CURRENT_LIST_DIR}/MeguvizRIFETargets.cmake")
check_required_components(MeguvizRIFE)
