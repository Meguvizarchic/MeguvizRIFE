{
  "schema_version": 1,
  "version": "@PROJECT_VERSION@",
  "build_fingerprint": "@MGR_BUILD_FP@",
  "private_sdk_fingerprint": "@MGR_PRIVATE_FP@",
  "target_system": "@CMAKE_SYSTEM_NAME@",
  "abi": "@ANDROID_ABI@",
  "compiler": "@CMAKE_CXX_COMPILER_ID@-@CMAKE_CXX_COMPILER_VERSION@",
  "job_observation": "@MGR_ENABLE_JOB_OBSERVATION@",
  "shared_plan": "@MGR_SHARED_PLAN_ENABLED@",
  "profiles": ["CPU_FP32_REFERENCE", "CPU_FP16_LEGACY", "VULKAN_LEGACY_FP16", "VULKAN_LEGACY_FP32"],
  "catalog": "profiles.json",
  "gpu_qualification": "INCONCLUSIVE",
  "optimization_defaults": "disabled",
  "weights_bundled": false
}
